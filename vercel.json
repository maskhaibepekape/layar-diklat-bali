{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/:path*.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Access-Control-Expose-Headers", "value": "Date, Age" }
      ]
    },
    {
      "source": "/ping.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/:match*" },
    { "source": "/admin/:match*", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/bali", "destination": "/bali/index.html" },
    { "source": "/medan", "destination": "/medan/index.html" },
    { "source": "/makassar", "destination": "/makassar/index.html" },
    { "source": "/ciawi", "destination": "/ciawi/index.html" }
  ]
}
